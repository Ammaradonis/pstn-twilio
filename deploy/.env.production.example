# Production environment template.
# Fill these in as Fly secrets / Render secret env vars / Cloudflare Pages env.
# Do NOT commit this file with real values.

# ────────────────────── API runtime ──────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.bestsoftphone.site
WEB_APP_URL=https://app.bestsoftphone.site
CORS_ORIGINS=https://bestsoftphone.site,https://app.bestsoftphone.site
COOKIE_DOMAIN=bestsoftphone.site

# ────────────────────── Database ─────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
DIRECT_DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# ────────────────────── Redis ────────────────────────────
REDIS_URL=rediss://<host>:<port>?password=<password>

# ────────────────────── Auth ─────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
# Set once to seed the owner via /api/auth/bootstrap-owner. Unset after first use.
BOOTSTRAP_TOKEN=
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# ────────────────────── Twilio ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_DEFAULT_COUNTRY=US
TWILIO_WEBHOOK_BASE_URL=https://api.bestsoftphone.site
TWILIO_VOICE_STATUS_CALLBACK_URL=https://api.bestsoftphone.site/webhooks/twilio/voice/status
TWILIO_MESSAGING_STATUS_CALLBACK_URL=https://api.bestsoftphone.site/webhooks/twilio/messaging/status

# ────────────────────── Cloudflare (CI / deploy) ─────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
NAMECHEAP_DOMAIN=bestsoftphone.site

# ────────────────────── Cloudflare R2 (call recordings) ──
# Required for browser recordings and the Twilio archiver. Without all three of
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_RECORDINGS_BUCKET the API logs
# "R2 is not configured; recordings stay at Twilio", POST /api/recordings/browser
# returns 503, and the archiver sweep never starts.
# R2_ACCESS_KEY_ID/SECRET are the R2 API token's Access Key ID and Secret.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECORDINGS_BUCKET=call-recordings
# Optional: defaults to CLOUDFLARE_ACCOUNT_ID when unset.
# R2_ACCOUNT_ID=
# Set to "false" to keep Twilio's copy after a recording is archived to R2.
# RECORDINGS_DELETE_FROM_TWILIO=true

# ────────────────────── Frontend build ───────────────────
# These are read at build time by Vite; ship them in Cloudflare Pages env, not Fly.
VITE_API_BASE_URL=https://api.bestsoftphone.site/api
VITE_WS_URL=wss://api.bestsoftphone.site
VITE_APP_NAME=pstn-twilio
VITE_REPEAT_DIAL_WARNING_ENABLED=false

# ── Google Sheets & Gmail (post-call CRM) ──────────────────────────────────────
# One OAuth client (Google Cloud project local-gmail-510114) for Calendar, Sheets
# and Gmail; also uses TOKEN_ENCRYPTION_KEY. In that project, enable the
# Calendar, Sheets, Drive and Gmail APIs and register this redirect URI:
#   https://api.bestsoftphone.site/webhooks/google-sheets/oauth/callback
# Follow-up emails are scheduled in Postgres (sheets_push_logs); no queue needed.
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_CLIENT_SECRET=
# Optional overrides:
GOOGLE_SHEETS_OAUTH_REDIRECT_URI=
US_CONQUEST_SHEET_ID=
