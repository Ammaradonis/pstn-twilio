generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum NumberType {
  LOCAL
  MOBILE
  TOLL_FREE
  UNKNOWN
}

enum WhatsAppCompatibilityStatus {
  UNKNOWN
  NOT_GUARANTEED
  USER_TESTING
  UNSUPPORTED
  APPROVED_BUSINESS_SENDER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  FAILED
  NO_ANSWER
  CANCELED
}

enum RecordingStatus {
  IN_PROGRESS
  COMPLETED
  ABSENT
}

enum WebhookProvider {
  TWILIO
}

enum AiCallDirection {
  OUTBOUND
  INBOUND
}

enum AiCallStatus {
  WAITING
  QUEUED
  RINGING
  IN_PROGRESS
  FORWARDING
  ENDED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         UserRole  @default(OWNER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")
  disabledAt   DateTime? @map("disabled_at")
  // Which web app the user signs in to: "console" (the softphone console) or
  // "voice" (the phone-style app with calls, messages, voicemail and contacts).
  experience   String    @default("console")

  sessions            Session[]
  phoneNumbers        PhoneNumber[]
  numberSearches      NumberSearch[]
  voiceIdentities     VoiceIdentity[]
  outboundCallIntents OutboundCallIntent[]
  auditLogs           AuditLog[]
  updatedSettings     AppSetting[]
  aiCalls             AiCall[]
  googleCalendar      GoogleCalendarConnection?
  googleSheets        GoogleSheetsConnection?
  emailFinderJobs     EmailFinderJob[]
  voiceSettings       VoiceSettings?
  voicemailGreeting   VoicemailGreeting?
  contacts            Contact[]
  blockedNumbers      BlockedNumber[]
  forwardingNumbers   ForwardingNumber[]
  devices             UserDevice[]
  readMarkers         ReadMarker[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model TwilioAccount {
  id           String   @id @default(uuid())
  accountSid   String   @unique @map("account_sid")
  friendlyName String?  @map("friendly_name")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  phoneNumbers PhoneNumber[]

  @@map("twilio_accounts")
}

model PhoneNumber {
  id                            String                      @id @default(uuid())
  userId                        String?                     @map("user_id")
  twilioAccountSid              String                      @map("twilio_account_sid")
  twilioIncomingPhoneNumberSid  String                      @unique @map("twilio_incoming_phone_number_sid")
  phoneNumberE164               String                      @unique @map("phone_number_e164")
  country                       String?
  region                        String?
  locality                      String?
  postalCode                    String?                     @map("postal_code")
  areaCode                      String?                     @map("area_code")
  numberType                    NumberType                  @default(UNKNOWN) @map("number_type")
  capabilitiesVoice             Boolean                     @default(false) @map("capabilities_voice")
  capabilitiesSms               Boolean                     @default(false) @map("capabilities_sms")
  capabilitiesMms               Boolean                     @default(false) @map("capabilities_mms")
  capabilitiesWhatsappCandidate Boolean                     @default(false) @map("capabilities_whatsapp_candidate")
  whatsappCompatibilityStatus   WhatsAppCompatibilityStatus @default(UNKNOWN) @map("whatsapp_compatibility_status")
  voiceWebhookUrl               String?                     @map("voice_webhook_url")
  smsWebhookUrl                 String?                     @map("sms_webhook_url")
  statusCallbackUrl             String?                     @map("status_callback_url")
  friendlyName                  String?                     @map("friendly_name")
  tags                          Json?
  active                        Boolean                     @default(true)
  purchasedAt                   DateTime                    @default(now()) @map("purchased_at")
  releasedAt                    DateTime?                   @map("released_at")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  twilioAccount       TwilioAccount        @relation(fields: [twilioAccountSid], references: [accountSid], onDelete: Cascade)
  smsMessages         SmsMessage[]
  calls               Call[]
  voiceIdentities     VoiceIdentity[]
  outboundCallIntents OutboundCallIntent[]

  @@index([phoneNumberE164])
  @@index([twilioIncomingPhoneNumberSid])
  @@index([userId])
  @@map("phone_numbers")
}

model NumberSearch {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  country       String
  areaCode      String?  @map("area_code")
  contains      String?
  numberType    String?  @map("number_type")
  requiredSms   Boolean  @default(false) @map("required_sms")
  requiredVoice Boolean  @default(false) @map("required_voice")
  resultCount   Int      @default(0) @map("result_count")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("number_searches")
}

model SmsMessage {
  id               String           @id @default(uuid())
  phoneNumberId    String           @map("phone_number_id")
  twilioMessageSid String?          @unique @map("twilio_message_sid")
  direction        MessageDirection
  fromE164         String           @map("from_e164")
  toE164           String           @map("to_e164")
  body             String?
  numMedia         Int              @default(0) @map("num_media")
  media            Json?
  status           MessageStatus    @default(RECEIVED)
  errorCode        String?          @map("error_code")
  errorMessage     String?          @map("error_message")
  rawPayload       Json?            @map("raw_payload")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId, createdAt(sort: Desc)])
  @@index([twilioMessageSid])
  @@map("sms_messages")
}

model Call {
  id               String        @id @default(uuid())
  phoneNumberId    String?       @map("phone_number_id")
  twilioCallSid    String?       @unique @map("twilio_call_sid")
  parentCallSid    String?       @map("parent_call_sid")
  direction        CallDirection
  fromE164         String        @map("from_e164")
  toE164           String        @map("to_e164")
  browserIdentity  String?       @map("browser_identity")
  selectedCallerId String?       @map("selected_caller_id")
  destinationE164  String?       @map("destination_e164")
  status           CallStatus    @default(INITIATED)
  durationSeconds  Int?          @map("duration_seconds")
  price            String?
  priceUnit        String?       @map("price_unit")
  rawPayload       Json?         @map("raw_payload")
  startedAt        DateTime?     @map("started_at")
  answeredAt       DateTime?     @map("answered_at")
  endedAt          DateTime?     @map("ended_at")
  // Voice app calls: where an incoming call was picked up ("app", "app:<deviceId>",
  // "phone:<e164>") or "blocked" when the caller was turned away.
  handledBy        String?       @map("handled_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  phoneNumber PhoneNumber?    @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  recordings  CallRecording[]

  @@index([phoneNumberId, createdAt(sort: Desc)])
  @@index([twilioCallSid])
  @@map("calls")
}

model CallRecording {
  id                 String          @id @default(uuid())
  callId             String?         @map("call_id")
  twilioCallSid      String          @map("twilio_call_sid")
  // Null for recordings made in the browser (source "browser").
  twilioRecordingSid String?         @unique @map("twilio_recording_sid")
  recordingUrl       String?         @map("recording_url")
  status             RecordingStatus @default(IN_PROGRESS)
  durationSeconds    Int?            @map("duration_seconds")
  channels           Int?
  source             String?
  track              String?
  rawPayload         Json?           @map("raw_payload")
  startedAt          DateTime?       @map("started_at")
  // Voicemail only: Twilio's transcription and when the user first played it.
  transcript         String?
  transcriptStatus   String?         @map("transcript_status")
  heardAt            DateTime?       @map("heard_at")
  // The file in our own object storage (R2). Twilio recordings are copied
  // there and then deleted from Twilio; browser recordings are uploaded there.
  storageKey         String?         @map("storage_key")
  contentType        String?         @map("content_type")
  sizeBytes          Int?            @map("size_bytes")
  storedAt           DateTime?       @map("stored_at")
  twilioDeletedAt    DateTime?       @map("twilio_deleted_at")
  archiveAttempts    Int             @default(0) @map("archive_attempts")
  archiveError       String?         @map("archive_error")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  call Call? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([callId])
  @@index([twilioCallSid])
  @@index([twilioRecordingSid])
  @@index([status, storedAt])
  @@map("call_recordings")
}

model VoiceIdentity {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  phoneNumberId String?  @map("phone_number_id")
  identity      String   @unique
  label         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("voice_identities")
}

model OutboundCallIntent {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  phoneNumberId     String    @map("phone_number_id")
  identity          String
  destinationE164   String    @map("destination_e164")
  selectedCallerId  String    @map("selected_caller_id")
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  consumedByCallSid String?   @map("consumed_by_call_sid")
  recordCall        Boolean   @default(true) @map("record_call")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([identity, expiresAt])
  @@index([phoneNumberId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([consumedByCallSid])
  @@map("outbound_call_intents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("audit_logs")
}

model WebhookEvent {
  id             String          @id @default(uuid())
  provider       WebhookProvider
  eventType      String          @map("event_type")
  signatureValid Boolean         @map("signature_valid")
  twilioSid      String?         @map("twilio_sid")
  dedupeKey      String?         @unique @map("dedupe_key")
  rawPayload     Json            @map("raw_payload")
  processedAt    DateTime?       @map("processed_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([dedupeKey])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_events")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

// A Vapi AI agent call: outbound to a prospect, or a prospect calling back.
model AiCall {
  id             String          @id @default(uuid())
  userId         String?         @map("user_id")
  vapiCallId     String?         @unique @map("vapi_call_id")
  direction      AiCallDirection @default(OUTBOUND)
  customerE164   String          @map("customer_e164")
  stateCode      String          @map("state_code")
  timeZone       String          @map("time_zone")
  status         AiCallStatus    @default(QUEUED)
  outcome        String?
  endedReason    String?         @map("ended_reason")
  summary        String?
  structuredData Json?           @map("structured_data")
  transcript     String?
  recordingUrl   String?         @map("recording_url")
  schoolName     String?         @map("school_name")
  contactName    String?         @map("contact_name")
  contactEmail   String?         @map("contact_email")
  callbackTime   String?         @map("callback_time")
  consultStartAt DateTime?       @map("consult_start_at")
  consultEventId String?         @map("consult_event_id")
  consultMeetUrl String?         @map("consult_meet_url")
  costUsd        Decimal?        @map("cost_usd") @db.Decimal(10, 4)
  startedAt      DateTime?       @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([customerE164, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_calls")
}

// Numbers that asked not to be called again. AI calls to them are refused.
model DoNotCallNumber {
  e164      String   @id
  reason    String?
  source    String
  aiCallId  String?  @map("ai_call_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("do_not_call_numbers")
}

// OAuth access to a user's Google Calendar, used to book consultations.
model GoogleCalendarConnection {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  googleEmail           String?  @map("google_email")
  calendarId            String   @default("primary") @map("calendar_id")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

// OAuth access to the user's Google account for Sheets writes and Gmail sends.
// Reuses the Calendar OAuth client (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET).
model GoogleSheetsConnection {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  googleEmail           String?  @map("google_email")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushLogs SheetsPushLog[]

  @@map("google_sheets_connections")
}

// One row per post-call status push. Also the follow-up email schedule:
// PENDING rows are sent by SheetsFollowUpService once emailDueAt passes.
model SheetsPushLog {
  id              String    @id @default(uuid())
  connectionId    String    @map("connection_id")
  spreadsheetId   String    @map("spreadsheet_id")
  sheetTitle      String    @map("sheet_title")
  rowIndex        Int       @map("row_index")
  destinationE164 String    @map("destination_e164")
  callerE164      String    @map("caller_e164")
  tags            Json // string[] in selection order
  customNote      String?   @map("custom_note")
  cellValue       String    @map("cell_value")
  timeZone        String    @map("time_zone")
  schoolName      String?   @map("school_name")
  // NONE | PENDING | SENDING | SENT | FAILED | CANCELLED | MANUAL (contact form, sent by hand)
  emailStatus     String    @default("NONE") @map("email_status")
  emailTo         String?   @map("email_to")
  // Status key of the follow-up sequence (templates/sequences/<key>.txt).
  emailTemplate   String?   @map("email_template")
  // Which of the sequence's 6 emails goes out next (1-based).
  sequenceStep    Int       @default(1) @map("sequence_step")
  // The lead's sheet row when the call was pushed, by normalized header; the
  // sequence variables come from it.
  rowData         Json?     @map("row_data")
  emailDueAt      DateTime? @map("email_due_at")
  emailAttempts   Int       @default(0) @map("email_attempts")
  emailError      String?   @map("email_error")
  emailSentAt     DateTime? @map("email_sent_at")
  contactFormUrl  String?   @map("contact_form_url")
  formLeaseToken  String?   @map("form_lease_token")
  callEndedAt     DateTime  @map("call_ended_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  connection GoogleSheetsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt(sort: Desc)])
  @@index([connectionId, destinationE164])
  @@index([emailStatus, emailDueAt])
  @@map("sheets_push_logs")
}

// Background email finding for one sheet tab. The worker runs on the user's PC
// (workers/email-finder) and pulls rows from this queue.
model EmailFinderJob {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  spreadsheetId String    @map("spreadsheet_id")
  sheetTitle    String    @map("sheet_title")
  // RUNNING | PAUSED | DONE | CANCELLED
  status        String    @default("RUNNING")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  finishedAt    DateTime? @map("finished_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows EmailFinderRow[]

  @@unique([userId, spreadsheetId, sheetTitle])
  @@map("email_finder_jobs")
}

// One sheet row to research. Identified by a fingerprint (name + phone +
// website) so it is found again after the user sorts or inserts rows.
model EmailFinderRow {
  id               String    @id @default(uuid())
  jobId            String    @map("job_id")
  fingerprint      String
  input            Json
  // PENDING | CLAIMED | FOUND | CONTACT_FORM | NOT_FOUND | FAILED
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  claimedAt        DateTime? @map("claimed_at")
  leaseToken       String?   @map("lease_token")
  nextAttemptAt    DateTime? @map("next_attempt_at")
  researchComplete Boolean   @default(false) @map("research_complete")
  email            String?
  emailType        String?   @map("email_type")
  confidence       Int?
  sourceUrl        String?   @map("source_url")
  decisionMaker    String?   @map("decision_maker")
  contactFormUrl   String?   @map("contact_form_url")
  notes            String?
  // How the address was found, e.g. "Facebook contact info via iPhone emulation"
  method           String?
  // Verified details for the sheet's empty cells (websiteUrl, phoneNumber, facebookUrl, ...)
  enrichment       Json?
  writtenAt        DateTime? @map("written_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  job EmailFinderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, fingerprint])
  @@index([jobId, status])
  @@index([status, claimedAt])
  @@index([status, nextAttemptAt])
  @@map("email_finder_rows")
}

// ---------------------------------------------------------------------------
// Voice app (User.experience = "voice"): a phone-style app for one person's
// number, with linked phones, voicemail, contacts and blocking.
// ---------------------------------------------------------------------------

model VoiceSettings {
  userId              String    @id @map("user_id")
  // Calls, texts and voicemail before this belong to the number's earlier owner
  // and are not shown in the app.
  historyStartsAt     DateTime  @default(now()) @map("history_starts_at")
  // Ring the app on every signed-in device.
  ringDevices         Boolean   @default(true) @map("ring_devices")
  // Linked phones hear who is calling and press 1 to take the call, so their
  // own voicemail can't pick it up.
  screenCalls         Boolean   @default(true) @map("screen_calls")
  ringSeconds         Int       @default(25) @map("ring_seconds")
  doNotDisturb        Boolean   @default(false) @map("do_not_disturb")
  // Do not disturb switches itself off at this time; null keeps it on.
  doNotDisturbUntil   DateTime? @map("do_not_disturb_until")
  voicemailEnabled    Boolean   @default(true) @map("voicemail_enabled")
  voicemailTranscribe Boolean   @default(true) @map("voicemail_transcribe")
  // default | text | recorded
  greetingMode        String    @default("default") @map("greeting_mode")
  greetingText        String?   @map("greeting_text")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_settings")
}

// A voicemail greeting recorded in the browser, served to Twilio <Play> at an
// unguessable URL.
model VoicemailGreeting {
  userId      String   @id @map("user_id")
  audio       Bytes
  contentType String   @map("content_type")
  durationMs  Int      @map("duration_ms")
  token       String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voicemail_greetings")
}

model Contact {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  company   String?
  email     String?
  notes     String?
  starred   Boolean  @default(false)
  // manual | device | vcard
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phones ContactPhone[]

  @@index([userId, name])
  @@map("contacts")
}

model ContactPhone {
  id        String  @id @default(uuid())
  contactId String  @map("contact_id")
  userId    String  @map("user_id")
  e164      String
  // mobile | home | work | other
  label     String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, e164])
  @@index([userId, e164])
  @@map("contact_phones")
}

// Calls from these numbers are rejected unanswered and their texts are hidden.
model BlockedNumber {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  e164      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, e164])
  @@map("blocked_numbers")
}

// Personal or desk phones that ring together with the app (at most six).
model ForwardingNumber {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  e164            String
  label           String
  enabled         Boolean   @default(true)
  verifiedAt      DateTime? @map("verified_at")
  // Verification: a call asks for the code shown on screen.
  verifyCodeHash  String?   @map("verify_code_hash")
  verifyExpiresAt DateTime? @map("verify_expires_at")
  verifyCallSid   String?   @map("verify_call_sid")
  // calling | failed | wrong-code
  verifyStatus    String?   @map("verify_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, e164])
  @@map("forwarding_numbers")
}

// A browser or installed app the user signs in on. The id is generated by the
// device. Holds its Web Push subscription.
model UserDevice {
  id            String    @id
  userId        String    @map("user_id")
  name          String
  platform      String?
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  pushEndpoint  String?   @unique @map("push_endpoint")
  pushP256dh    String?   @map("push_p256dh")
  pushAuth      String?   @map("push_auth")
  pushUpdatedAt DateTime? @map("push_updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// What the user has seen, shared by all of their devices. Keys: "calls"
// (missed calls) and "sms:<e164>" (a conversation).
model ReadMarker {
  userId String   @map("user_id")
  key    String
  readAt DateTime @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("read_markers")
}
