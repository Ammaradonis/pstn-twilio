# Backend
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://api.bestsoftphone.site
WEB_APP_URL=http://localhost:5173

# Database (Neon/Postgres)
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DIRECT_DATABASE_URL=

# Redis (Upstash or other)
REDIS_URL=

# Sessions / Auth
SESSION_SECRET=change-me
JWT_SECRET=change-me
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_TOKEN=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_DEFAULT_COUNTRY=US
TWILIO_WEBHOOK_BASE_URL=https://api.bestsoftphone.site
TWILIO_VOICE_STATUS_CALLBACK_URL=$TWILIO_WEBHOOK_BASE_URL/webhooks/twilio/voice/status
TWILIO_MESSAGING_STATUS_CALLBACK_URL=$TWILIO_WEBHOOK_BASE_URL/webhooks/twilio/messaging/status

# Owner bootstrap (use only once in a safe environment)
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=changeme

# Cloudflare / Deployment (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
NAMECHEAP_DOMAIN=bestsoftphone.site

# Call recordings in Cloudflare R2 (apps/api/src/recordings). Browser recordings
# upload here, and Twilio recordings are copied here then deleted from Twilio.
# Until all three are set, recordings stay at Twilio and browser recordings wait
# in the browser. Credentials: R2 > Manage API tokens > Object Read & Write,
# scoped to the bucket. The account is CLOUDFLARE_ACCOUNT_ID unless R2_ACCOUNT_ID.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECORDINGS_BUCKET=call-recordings
# false keeps Twilio's copy after archiving (default: delete it)
RECORDINGS_DELETE_FROM_TWILIO=true

# Other
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=pstn-twilio
VITE_REPEAT_DIAL_WARNING_ENABLED=false

# Vapi AI agent: outbound calls that book consultations (apps/api/src/ai-calls)
VAPI_PRIVATE_KEY=
# Vapi phone number id of the line calls are placed from (the 667 number)
VAPI_PHONE_NUMBER_ID=
# Printed by: npx tsx apps/api/scripts/vapi-sync.ts
VAPI_ASSISTANT_ID=
# Shared secret Vapi sends to /webhooks/vapi (any long random string)
VAPI_WEBHOOK_SECRET=
AI_CALLER_NUMBER=+16672206726
AI_AGENT_NAME=Sarah
# Who the agent calls on behalf of, and who runs the consultation
AI_BUSINESS_NAME=
AI_HOST_NAME=
# Optional demo line prospects can call to hear the agent answer as a school
AI_DEMO_NUMBER=+18776524532
AI_DEFAULT_STATE=AL
# Prospect-local calling window (24h clock)
AI_CALL_WINDOW_START_HOUR=8
AI_CALL_WINDOW_END_HOUR=21
# Consultation slots, in the prospect's local time
CONSULT_MINUTES=20
CONSULT_STEP_MINUTES=30
CONSULT_DAY_START_HOUR=9
CONSULT_DAY_END_HOUR=18
CONSULT_WEEKDAYS=1,2,3,4,5
CONSULT_MIN_LEAD_MINUTES=120
CONSULT_HORIZON_DAYS=10
CONSULT_BUFFER_MINUTES=10
# Google Calendar uses GOOGLE_CLOUD_CLIENT_ID / GOOGLE_CLOUD_CLIENT_SECRET (see the
# Google Sheets & Gmail section); register this redirect URI on that client too:
# https://<api host>/webhooks/google-calendar/oauth/callback
# 32 random bytes, base64: encrypts stored Google refresh tokens
TOKEN_ENCRYPTION_KEY=

# ── Google Sheets & Gmail (post-call CRM) ──────────────────────────────────────
# One OAuth client (Google Cloud project local-gmail-510114) for Calendar, Sheets
# and Gmail; also uses TOKEN_ENCRYPTION_KEY. In that project, enable the
# Calendar, Sheets, Drive and Gmail APIs and register this redirect URI:
#   <api base url>/webhooks/google-sheets/oauth/callback
# Follow-up emails are scheduled in Postgres (sheets_push_logs); no queue needed.
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_CLIENT_SECRET=
# Optional overrides:
GOOGLE_SHEETS_OAUTH_REDIRECT_URI=
US_CONQUEST_SHEET_ID=
